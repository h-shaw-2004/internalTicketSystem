# Template only — real values go in .env, which is gitignored. Do not edit this
# file with your own credentials; copy it first:  cp .env.example .env
#
# Both values come from the Supabase dashboard:
#   URL -> Project Settings > Data API > Project URL
#   Key -> Project Settings > API Keys > publishable (NOT the sb_secret_ one)
#
# Every VITE_ variable is inlined into the browser bundle, so only the
# publishable/anon key belongs here — never the secret/service-role key.

# Bare origin, no trailing path — supabase-js appends /rest/v1 itself.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-key-here
