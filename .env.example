# Template only — real values go in .env, which is gitignored. Do not edit this
# file with your own credentials; copy it first:  cp .env.example .env
#
# Read by the API server only (server/env.js). Nothing here reaches the browser:
# the frontend talks to /api and never to the database, so there is no key in the
# bundle to leak. Do not add VITE_ variables for database access — anything
# VITE_-prefixed is inlined into the JavaScript every visitor downloads.

# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Replace [YOUR-PASSWORD] with your database password. Use the "Session pooler"
# string if your network cannot reach the direct connection on port 5432.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Port the API server listens on. The Vite dev proxy expects 3001.
PORT=3001
